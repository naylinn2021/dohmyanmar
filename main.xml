final java.util.List<java.util.HashMap<String, String>> allCountries =
    java.util.Collections.synchronizedList(
        new java.util.ArrayList<java.util.HashMap<String, String>>()
    );

final java.util.List<java.util.HashMap<String, String>> displayCountries =
    java.util.Collections.synchronizedList(
        new java.util.ArrayList<java.util.HashMap<String, String>>()
    );

final android.widget.BaseAdapter adapter =
    new android.widget.BaseAdapter() {

    @Override
    public int getCount() {
        return displayCountries.size();
    }

    @Override
    public Object getItem(int pos) {
        return (pos >= 0 && pos < displayCountries.size())
            ? displayCountries.get(pos) : null;
    }

    @Override
    public long getItemId(int pos) {
        return pos;
    }

    @Override
    public android.view.View getView(
        int pos,
        android.view.View convertView,
        android.view.ViewGroup parent
    ) {

        if (convertView == null) {

            androidx.cardview.widget.CardView card =
                new androidx.cardview.widget.CardView(MainActivity.this);

            card.setCardBackgroundColor(
                android.graphics.Color.parseColor("#1A1C23")
            );
            card.setRadius((int) (12 * density));
            card.setCardElevation((int) (2 * density));
            card.setUseCompatPadding(false);

            android.widget.AbsListView.LayoutParams cardLp =
                new android.widget.AbsListView.LayoutParams(
                    android.widget.AbsListView.LayoutParams.MATCH_PARENT,
                    (int) (54 * density)
                );

            card.setLayoutParams(cardLp);

            android.widget.LinearLayout row =
                new android.widget.LinearLayout(MainActivity.this);

            row.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            row.setPadding(
                (int) (14 * density), 0,
                (int) (16 * density), 0
            );
            row.setGravity(android.view.Gravity.CENTER_VERTICAL);

            row.setLayoutParams(
                new android.view.ViewGroup.LayoutParams(-1, -1)
            );

            android.widget.TextView tvFlag =
                new android.widget.TextView(MainActivity.this);

            tvFlag.setTextSize(24);
            tvFlag.setGravity(android.view.Gravity.CENTER);

            android.widget.LinearLayout.LayoutParams flagLp =
                new android.widget.LinearLayout.LayoutParams(
                    (int) (38 * density),
                    (int) (38 * density)
                );

            flagLp.setMargins(0, 0, (int) (12 * density), 0);
            tvFlag.setLayoutParams(flagLp);
            tvFlag.setTag("tv_flag");
            row.addView(tvFlag);

            android.widget.TextView tvName =
                new android.widget.TextView(MainActivity.this);

            tvName.setTextColor(android.graphics.Color.WHITE);
            tvName.setTextSize(15);
            tvName.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
            tvName.setSingleLine(true);
            tvName.setEllipsize(android.text.TextUtils.TruncateAt.END);

            tvName.setLayoutParams(
                new android.widget.LinearLayout.LayoutParams(0, -2, 1.0f)
            );

            tvName.setTag("tv_name");
            row.addView(tvName);

            androidx.cardview.widget.CardView countCard =
                new androidx.cardview.widget.CardView(MainActivity.this);

            countCard.setCardBackgroundColor(
                android.graphics.Color.parseColor("#152438")
            );

            countCard.setRadius((int) (10 * density));
            countCard.setCardElevation(0);

            android.widget.LinearLayout.LayoutParams countCardLp =
                new android.widget.LinearLayout.LayoutParams(-2, -2);

            countCardLp.setMargins(0, 0, (int) (10 * density), 0);
            countCard.setLayoutParams(countCardLp);
            countCard.setTag("card_count");

            android.widget.TextView tvCount =
                new android.widget.TextView(MainActivity.this);

            tvCount.setTextColor(
                android.graphics.Color.parseColor("#448AFF")
            );
            tvCount.setTextSize(11);
            tvCount.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);

            tvCount.setPadding(
                (int) (10 * density), (int) (4 * density),
                (int) (10 * density), (int) (4 * density)
            );

            tvCount.setTag("tv_count");
            countCard.addView(tvCount);
            row.addView(countCard);

            android.widget.ImageView arrow =
                new android.widget.ImageView(MainActivity.this);

            arrow.setImageResource(android.R.drawable.ic_media_play);
            arrow.setColorFilter(
                android.graphics.Color.parseColor("#3F4555")
            );

            arrow.setLayoutParams(
                new android.widget.LinearLayout.LayoutParams(
                    (int) (12 * density),
                    (int) (12 * density)
                )
            );

            row.addView(arrow);
            card.addView(row);

            convertView = card;
        }

        if (pos >= displayCountries.size()) {
            return convertView;
        }

        final java.util.HashMap<String, String> map =
            displayCountries.get(pos);

        if (map == null) {
            return convertView;
        }

        final android.widget.TextView tvFlag =
            (android.widget.TextView) convertView.findViewWithTag("tv_flag");

        final android.widget.TextView tvName =
            (android.widget.TextView) convertView.findViewWithTag("tv_name");

        final androidx.cardview.widget.CardView cardCount =
            (androidx.cardview.widget.CardView) convertView.findViewWithTag("card_count");

        final android.widget.TextView tvCount =
            (android.widget.TextView) convertView.findViewWithTag("tv_count");

        tvName.setText(map.get("name"));
        tvFlag.setText(map.get("flag"));

        tvCount.setText("CUSTOM");
        cardCount.setVisibility(android.view.View.VISIBLE);

        return convertView;
    }
};

